//--------------------------------------------------------------------------------------------------
// Trigger: Unit Highest Kill Count
//--------------------------------------------------------------------------------------------------
bool libEFA54406_gt_UnitHighestKillCount_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_highest_unit;
    text lv_name_of_unit;
    string lv_name_of_unit_string;
    int lv_highest_kill_count;
    unit lv_unit_iterator;
    int lv_unit_kill_count;
    unitgroup lv_player_units;

    // Automatic Variable Declarations
    unitgroup autoB884A631_g;
    int autoB884A631_u;

    // Variable Initialization
    lv_name_of_unit_string = "";
    lv_player_units = UnitGroupEmpty();

    // Actions
    if (!runActions) {
        return true;
    }

    lv_player_units = UnitGroup(null, 1, RegionPlayableMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    autoB884A631_g = lv_player_units;
    autoB884A631_u = UnitGroupCount(autoB884A631_g, c_unitCountAll);
    for (;; autoB884A631_u -= 1) {
        lv_unit_iterator = UnitGroupUnitFromEnd(autoB884A631_g, autoB884A631_u);
        if (lv_unit_iterator == null) { break; }
        lv_unit_kill_count = UnitGetPropertyInt(lv_unit_iterator, c_unitPropKills, c_unitPropCurrent);
        if ((lv_unit_kill_count > lv_highest_kill_count)) {
            lv_highest_kill_count = lv_unit_kill_count;
            lv_name_of_unit = UnitGetName(lv_unit_iterator);
            lv_name_of_unit_string = TextToString(lv_name_of_unit);
        }

    }
    if ((lv_highest_kill_count <= 0)) {
        libEFA54406_gf_create_context("hghest_kill_count", "No one in your forces has killed anyone. I guess it's a peaceful life out there in the Koprulu Sector", true);
    }
    else {
        libEFA54406_gf_create_context("hghest_kill_count", lv_name_of_unit_string + " has killed the most with " + IntToString(lv_highest_kill_count) + " kills on record for this mission", true);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void libEFA54406_gt_UnitHighestKillCount_Init () {
    libEFA54406_gt_UnitHighestKillCount = TriggerCreate("libEFA54406_gt_UnitHighestKillCount_Func");
}

