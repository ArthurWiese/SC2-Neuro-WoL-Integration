//--------------------------------------------------------------------------------------------------
bool libEFA54406_gt_Currentresources_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_mineral_count;
    int lv_gas_count;
    string lv_economy_context;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_economy_context = "";

    // Actions
    if (!runActions) {
        return true;
    }

    lv_mineral_count = PlayerGetPropertyInt(1, c_playerPropMinerals);
    lv_gas_count = PlayerGetPropertyInt(1, c_playerPropVespene);
    lv_economy_context = "Current resources: " + IntToString(lv_mineral_count) + " Minerals | " + IntToString(lv_gas_count) + " Vespene Gas";
    libEFA54406_gf_create_context("resources", lv_economy_context, true);
    return true;
}

