//--------------------------------------------------------------------------------------------------
// Trigger: Init Map
//--------------------------------------------------------------------------------------------------
bool libEFA54406_gt_InitMap_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TriggerExecute(libEFA54406_gt_CreateNeuroIntegrationbank, true, false);
    TriggerExecute(libEFA54406_gt_LoadAbilityBank, true, true);
    TriggerExecute(libEFA54406_gt_CreateAbilityBank, true, false);
    Wait(1.0, c_timeReal);
    TriggerSendEvent("execute_actions_global");
    return true;
}

//--------------------------------------------------------------------------------------------------
void libEFA54406_gt_InitMap_Init () {
    libEFA54406_gt_InitMap = TriggerCreate("libEFA54406_gt_InitMap_Func");
    TriggerAddEventMapInit(libEFA54406_gt_InitMap);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Create NeuroIntegration bank
//--------------------------------------------------------------------------------------------------
bool libEFA54406_gt_CreateNeuroIntegrationbank_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    BankLoad("NeuroIntegration", 1);
    libEFA54406_gv_neuroIntegration = BankLastCreated();
    BankWait(libEFA54406_gv_neuroIntegration);
    BankSectionRemove(libEFA54406_gv_neuroIntegration, "game_context");
    BankSectionRemove(libEFA54406_gv_neuroIntegration, "possible_actions");
    BankSectionRemove(libEFA54406_gv_neuroIntegration, "do_action");
    BankSectionRemove(libEFA54406_gv_neuroIntegration, "force_action");
    BankValueSetFromFlag(libEFA54406_gv_neuroIntegration, "game_state", "in_mission", true);
    BankValueSetFromInt(libEFA54406_gv_neuroIntegration, "game_state", "active", 0);
    BankSave(libEFA54406_gv_neuroIntegration);
    TriggerExecute(libEFA54406_gt_ClearQueue, true, false);
    libEFA54406_gf_create_action_1_arg("chat_message", true, "Post a message into the game chat", "string", -1);
    Wait(0.5, c_timeReal);
    if ((libEFA54406_gv_is_intermission == false)) {
        TriggerEnable(libCamp_gt_TS_VSScreenContinue, false);
        TriggerEnable(libCamp_gt_TS_VSScreenPlayAgain, false);
        libEFA54406_gf_create_context("mission_intro", "You have entered a mission. You can assist the player and have access to powerful abilities which use a regenerating Energy resource.", true);
        if ((libEFA54406_gv_is_blocking == false)) {
            libEFA54406_gf_BlockContext(false);
        }

    }

    return true;
}

