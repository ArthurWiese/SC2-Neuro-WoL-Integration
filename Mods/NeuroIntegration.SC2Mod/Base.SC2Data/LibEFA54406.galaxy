//--------------------------------------------------------------------------------------------------
// Trigger: Player Victory Play Again
//--------------------------------------------------------------------------------------------------
bool libEFA54406_gt_PlayerVictoryPlayAgain_Func (bool testConds, bool runActions) {
    // Variable Declarations
    bool lv_simulation;

    // Automatic Variable Declarations
    int autoC9E6B4E9_val;

    // Variable Initialization
    lv_simulation = true;

    // Actions
    if (!runActions) {
        return true;
    }

    UISetFrameVisible(PlayerGroupAll(), c_syncFrameTypeVictoryPanel, false);
    autoC9E6B4E9_val = EventVictoryPanelDifficultySelected();
    if (autoC9E6B4E9_val == 4) {
        libEFA54406_gf_create_context("player_action", "Player chose to replay the mission on Brutal difficulty", true);
        TriggerDebugOutput(1, (StringExternal("Param/Value/lib_EFA54406_07EADF30") + StringExternal("Param/Value/lib_EFA54406_DCD42E87")), false);
    }
    else if (autoC9E6B4E9_val == 3) {
        libEFA54406_gf_create_context("player_action", "Player chose to replay the mission on Hard difficulty", true);
        TriggerDebugOutput(1, (StringExternal("Param/Value/lib_EFA54406_87B5E461") + StringExternal("Param/Value/lib_EFA54406_6028E76B")), false);
    }
    else if (autoC9E6B4E9_val == 2) {
        libEFA54406_gf_create_context("player_action", "Player chose to replay the mission on Normal difficulty", true);
        TriggerDebugOutput(1, (StringExternal("Param/Value/lib_EFA54406_2A2F68A6") + StringExternal("Param/Value/lib_EFA54406_9A6CF506")), false);
    }
    else if (autoC9E6B4E9_val == 1) {
        libEFA54406_gf_create_context("player_action", "Player chose to replay the mission on Casual difficulty", true);
        TriggerDebugOutput(1, (StringExternal("Param/Value/lib_EFA54406_06F37814") + StringExternal("Param/Value/lib_EFA54406_4537635B")), false);
    }
    else {
        TriggerDebugOutput(1, (StringExternal("Param/Value/lib_EFA54406_E675F2F5") + StringExternal("Param/Value/lib_EFA54406_48AB6FAD")), false);
    }
    if ((libCamp_gv_tSX_IsSimulation == true)) {
        lv_simulation = true;
    }
    else {
        lv_simulation = false;
    }
    libCamp_gf_PrepareForMission(libCamp_gv_tS_CurrentMap, lv_simulation, true, EventVictoryPanelDifficultySelected());
    Wait(1.0, c_timeReal);
    GameOver(1, c_gameOverVictory, false, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void libEFA54406_gt_PlayerVictoryPlayAgain_Init () {
    libEFA54406_gt_PlayerVictoryPlayAgain = TriggerCreate("libEFA54406_gt_PlayerVictoryPlayAgain_Func");
    TriggerAddEventVictoryPanelPlayMissionAgain(libEFA54406_gt_PlayerVictoryPlayAgain, c_playerAny);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Player Victory Continue
//--------------------------------------------------------------------------------------------------
bool libEFA54406_gt_PlayerVictoryContinue_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    UISetFrameVisible(PlayerGroupAll(), c_syncFrameTypeVictoryPanel, false);
    libEFA54406_gf_create_context("player_action", "Player chose to close the Victory screen and continue", true);
    Wait(1.0, c_timeReal);
    if ((libCamp_gv_tS_CurrentMap != libCamp_ge_MapID_MapTValerian03)) {
        GameOver(1, c_gameOverVictory, false, false);
        return true;
    }

    libCamp_gf_TS_CampaignVictory();
    return true;
}

//--------------------------------------------------------------------------------------------------
void libEFA54406_gt_PlayerVictoryContinue_Init () {
    libEFA54406_gt_PlayerVictoryContinue = TriggerCreate("libEFA54406_gt_PlayerVictoryContinue_Func");
    TriggerAddEventVictoryPanelExit(libEFA54406_gt_PlayerVictoryContinue, c_playerAny);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Init Map
//--------------------------------------------------------------------------------------------------
bool libEFA54406_gt_InitMap_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TriggerExecute(libEFA54406_gt_CreateNeuroIntegrationbank, true, false);
    Wait(1.0, c_timeReal);
    TriggerSendEvent("execute_actions_global");
    return true;
}

//--------------------------------------------------------------------------------------------------
void libEFA54406_gt_InitMap_Init () {
    libEFA54406_gt_InitMap = TriggerCreate("libEFA54406_gt_InitMap_Func");
    TriggerAddEventMapInit(libEFA54406_gt_InitMap);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Create NeuroIntegration bank
//--------------------------------------------------------------------------------------------------
bool libEFA54406_gt_CreateNeuroIntegrationbank_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    BankLoad("NeuroIntegration", 1);
    BankWait(BankLastCreated());
    libEFA54406_gv_neuroIntegration = BankLastCreated();
    BankSectionRemove(BankLastCreated(), "game_context");
    BankSectionRemove(BankLastCreated(), "possible_actions");
    BankSectionRemove(BankLastCreated(), "do_action");
    BankSectionRemove(BankLastCreated(), "force_action");
    BankValueSetFromFlag(BankLastCreated(), "game_state", "in_mission", true);
    BankValueSetFromInt(BankLastCreated(), "game_state", "active", 0);
    BankSave(BankLastCreated());
    TriggerExecute(libEFA54406_gt_ClearQueue, true, false);
    libEFA54406_gf_create_action_1_arg("chat_message", true, "Post a message into the game chat", "string", -1);
    Wait(0.5, c_timeReal);
    if ((libEFA54406_gv_is_intermission == false)) {
        TriggerEnable(libCamp_gt_TS_VSScreenContinue, false);
        TriggerEnable(libCamp_gt_TS_VSScreenPlayAgain, false);
        if ((libEFA54406_gv_is_blocking == false)) {
            libEFA54406_gf_BlockContext(false);
        }

    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void libEFA54406_gt_CreateNeuroIntegrationbank_Init () {
    libEFA54406_gt_CreateNeuroIntegrationbank = TriggerCreate("libEFA54406_gt_CreateNeuroIntegrationbank_Func");
}

