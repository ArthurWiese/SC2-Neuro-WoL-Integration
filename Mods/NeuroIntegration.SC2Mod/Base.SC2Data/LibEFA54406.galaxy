//--------------------------------------------------------------------------------------------------
// Trigger: Unit Ability
//--------------------------------------------------------------------------------------------------
bool libEFA54406_gt_UnitAbility_Func (bool testConds, bool runActions) {
    // Variable Declarations
    text lv_attacked_unit_text;

    // Automatic Variable Declarations
    abilcmd autoF983FFD6_val;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((EventPlayer() == 1))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    autoF983FFD6_val = EventUnitAbility();
    if (autoF983FFD6_val == AbilityCommand("attack", 0)) {
        if ((EventUnitAbilityStage() == c_unitAbilStageExecute) && (UnitGroupHasUnit(UnitGroupSelected(1), EventUnit()) == true)) {
            if ((UnitGetOwner(EventUnitTargetUnit()) == 1)) {
                libEFA54406_gv_player_attack_selected_units = true;
                lv_attacked_unit_text = UnitGetName(EventUnitTargetUnit());
                libEFA54406_gv_attacked_unit = TextToString(lv_attacked_unit_text);
                libEFA54406_gv_attacked_unit = "YOUR OWN UNIT: " + libEFA54406_gv_attacked_unit;
            }
            else if ((libNtve_gf_PlayerIsEnemy(1, UnitGetOwner(EventUnitTargetUnit()), libNtve_ge_PlayerRelation_Neutral) == true)) {
                libEFA54406_gv_player_attack_selected_units = true;
                lv_attacked_unit_text = UnitGetName(EventUnitTargetUnit());
                libEFA54406_gv_attacked_unit = TextToString(lv_attacked_unit_text);
                libEFA54406_gv_attacked_unit = "NEUTRAL unit: " + libEFA54406_gv_attacked_unit;
            }
            else if ((libNtve_gf_PlayerIsEnemy(1, UnitGetOwner(EventUnitTargetUnit()), libNtve_ge_PlayerRelation_Ally) == true)) {
                libEFA54406_gv_player_attack_selected_units = true;
                lv_attacked_unit_text = UnitGetName(EventUnitTargetUnit());
                libEFA54406_gv_attacked_unit = TextToString(lv_attacked_unit_text);
                libEFA54406_gv_attacked_unit = "YOUR ALLIES UNIT: " + libEFA54406_gv_attacked_unit;
            }
        }

    }
    else if (autoF983FFD6_val == AbilityCommand("CommandCenterTrain", 0)) {
        if ((EventUnitAbilityStage() == c_unitAbilStageExecute)) {
