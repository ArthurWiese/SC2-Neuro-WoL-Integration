//--------------------------------------------------------------------------------------------------
bool libEFA54406_gt_UnitCombatContext_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((libEFA54406_gv_entered_combat == true)) {
        libEFA54406_gv_entered_combat = false;
        if ((libEFA54406_gv_entered_combat_context_cd == true)) {
            TriggerStop(libEFA54406_gt_UnitCombatContextCooldown);
            TriggerExecute(libEFA54406_gt_UnitCombatContextCooldown, true, false);
        }
        else {
            libEFA54406_gf_create_context("entered_combat", "Your forces are in a fight with the enemy!", true);
            libEFA54406_gv_entered_combat_context_cd = true;
            TriggerExecute(libEFA54406_gt_UnitCombatContextCooldown, true, false);
        }
    }

    return true;
}

