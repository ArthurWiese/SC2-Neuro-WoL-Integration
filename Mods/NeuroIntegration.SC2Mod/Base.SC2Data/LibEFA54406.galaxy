    if ((libEFA54406_gv_abilities_info_is_showing == true)) {
        DialogSetVisible(libEFA54406_gv_abilities_info, PlayerGroupAll(), false);
        DialogSetVisible(libEFA54406_gv_standard_dialog, PlayerGroupAll(), false);
        libEFA54406_gv_abilities_info_is_showing = false;
        libEFA54406_gf_ShowAbilities(true);
    }
    else {
        DialogSetVisible(libEFA54406_gv_abilities_info, PlayerGroupAll(), true);
        DialogSetVisible(libEFA54406_gv_standard_dialog, PlayerGroupAll(), false);
        libEFA54406_gv_abilities_info_is_showing = true;
        libEFA54406_gv_info_not_yet_shown = false;
    }
    return true;
}

