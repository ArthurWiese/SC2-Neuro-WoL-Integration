    libEFA54406_gt_PlayerVictoryPlayAgain = TriggerCreate("libEFA54406_gt_PlayerVictoryPlayAgain_Func");
    TriggerAddEventVictoryPanelPlayMissionAgain(libEFA54406_gt_PlayerVictoryPlayAgain, c_playerAny);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Player Victory Continue
//--------------------------------------------------------------------------------------------------
bool libEFA54406_gt_PlayerVictoryContinue_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    UISetFrameVisible(PlayerGroupAll(), c_syncFrameTypeVictoryPanel, false);
    libEFA54406_gf_create_context("player_action", "Player chose to close the Victory screen and continue", true);
    Wait(1.0, c_timeReal);
    if ((libCamp_gv_tS_CurrentMap != libCamp_ge_MapID_MapTValerian03)) {
        GameOver(1, c_gameOverVictory, false, false);
        return true;
    }

    libCamp_gf_TS_CampaignVictory();
    return true;
}

