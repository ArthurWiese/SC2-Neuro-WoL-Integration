    lv_victory_context = lv_victory_context + " Mission: " + TextToString(lv_temp_text) +".";
    lv_temp_text = libCamp_gf_FormatTimeCampaign(libCamp_gv_tS_MissionCompleteTime);
    lv_victory_context = lv_victory_context + " Mission time: " + TextToString(lv_temp_text)+ ".";
    if ((libCamp_gf_MissionReward(lp_mission) > 0)) {
        lv_temp_integer = libCamp_gf_MissionReward(lp_mission);
