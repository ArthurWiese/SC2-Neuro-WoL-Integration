//--------------------------------------------------------------------------------------------------
// Trigger: Current supply
//--------------------------------------------------------------------------------------------------
bool libEFA54406_gt_Currentsupply_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_supply_count;
    int lv_supply_max_count;
    int lv_supply_limit_count;
    string lv_economy_context;
    string lv_economy_context_part;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_economy_context = "";
    lv_economy_context_part = "";

    // Actions
    if (!runActions) {
        return true;
    }

    lv_supply_count = PlayerGetPropertyInt(1, c_playerPropSuppliesUsed);
    lv_supply_limit_count = PlayerGetPropertyInt(1, c_playerPropSuppliesLimit);
    lv_supply_max_count = MinI(lv_supply_limit_count, PlayerGetPropertyInt(1, c_playerPropSuppliesMade));
    lv_economy_context = lv_economy_context + "Current used supplies: " + IntToString(lv_supply_count) + "/" + IntToString(lv_supply_max_count);
    if ((lv_supply_max_count >= lv_supply_limit_count)) {
        lv_economy_context_part = lv_economy_context_part + ". Supply limit of " + IntToString(lv_supply_limit_count) + " reached. You cannot increase your maximum useable supply over this limit";
    }

    if ((lv_supply_count >= lv_supply_max_count)) {
        lv_economy_context_part = lv_economy_context_part + ". You're using all your useable supplies. You cannot produce any more units";
    }

    if ((lv_economy_context_part == "")) {
    }
    else {
        lv_economy_context = lv_economy_context + lv_economy_context_part;
    }
    libEFA54406_gf_create_context("resources", lv_economy_context, true);
    return true;
}

