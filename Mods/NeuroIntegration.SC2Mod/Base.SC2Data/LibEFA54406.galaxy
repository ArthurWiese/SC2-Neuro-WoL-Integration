    BankSave(BankLastCreated());
    if ((libEFA54406_gv_is_intermission == false)) {
        TriggerExecute(libEFA54406_gt_PlayerSelectedUnitsContextCompare, true, false);
    }

    TriggerSendEvent("execute_actions_map");
    return true;
}

