            }
        }

    }
    else if (autoF983FFD6_val == AbilityCommand("CommandCenterTrain", 0)) {
        if ((EventUnitAbilityStage() == c_unitAbilStageExecute)) {
        }

    }
    else if (autoF983FFD6_val == AbilityCommand("TacNukeStrike", 0)) {
        if ((EventUnitAbilityStage() == c_unitAbilStageComplete)) {
            libEFA54406_gv_player_use_nuke = true;
