//--------------------------------------------------------------------------------------------------
// Trigger: Player Activity Context
//--------------------------------------------------------------------------------------------------
bool libEFA54406_gt_PlayerActivityContext_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((libEFA54406_gv_is_intermission == false) && (libEFA54406_gv_is_blocking == false)) {
        Wait(0.3, c_timeReal);
        TriggerExecute(libEFA54406_gt_PlayerSelectedUnitsContextCompare, true, false);
        TriggerExecute(libEFA54406_gt_UnitCommandContext, true, false);
        TriggerExecute(libEFA54406_gt_CombatContext, true, false);
        TriggerExecute(libEFA54406_gt_UnitAttackedContext, true, false);
        if ((libEFA54406_gv_is_nobuild == false)) {
            TriggerExecute(libEFA54406_gt_EconomyContext, true, false);
            TriggerExecute(libEFA54406_gt_NeuroCanProduceUnits, true, false);
            TriggerExecute(libEFA54406_gt_NeuroCanCallMercenaries, true, false);
            TriggerExecute(libEFA54406_gt_NeuroCanResearchUpgrades, true, false);
        }

    }

    return true;
}

