void libEFA54406_gt_ClearQueue_Init () {
    libEFA54406_gt_ClearQueue = TriggerCreate("libEFA54406_gt_ClearQueue_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Init Load
//--------------------------------------------------------------------------------------------------
bool libEFA54406_gt_InitLoad_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TriggerSendEvent("stop_execution");
    BankRestore(libEFA54406_gv_neuroIntegration, 1, libEFA54406_gv_currentbankbackupid);
    BankSave(libEFA54406_gv_neuroIntegration);
    Wait(1.0, c_timeReal);
    TriggerSendEvent("execute_actions_global");
    TriggerExecute(libEFA54406_gt_StartupContext, true, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void libEFA54406_gt_InitLoad_Init () {
    libEFA54406_gt_InitLoad = TriggerCreate("libEFA54406_gt_InitLoad_Func");
    TriggerAddEventLoadGameDone(libEFA54406_gt_InitLoad);
}

