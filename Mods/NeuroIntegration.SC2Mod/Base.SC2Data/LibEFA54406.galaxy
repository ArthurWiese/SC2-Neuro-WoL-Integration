    else if ((TechTreeUpgradeCount(1, "ProtossGroundWeaponsLevel2", c_techCountCompleteOnly) == 1)) {
        lv_upgrades_string = lv_upgrades_string + "Ground Weapons Level 2, ";
    }
    else if ((TechTreeUpgradeCount(1, "ProtossGroundWeaponsLevel1", c_techCountCompleteOnly) == 1)) {
        lv_upgrades_string = lv_upgrades_string + "Ground Weapons Level 1, ";
    }
    if (((TechTreeUpgradeCount(1, "TerranInfantryWeaponsLevel3", c_techCountCompleteOnly) == 1) || (TechTreeUpgradeCount(1, "TerranInfantryWeaponsUltraCapacitorsLevel3", c_techCountCompleteOnly) == 1))) {
        lv_upgrades_string = lv_upgrades_string + "Infantry Weapons Level 3, ";
    }
    else if (((TechTreeUpgradeCount(1, "TerranInfantryWeaponsLevel2", c_techCountCompleteOnly) == 1) || (TechTreeUpgradeCount(1, "TerranInfantryWeaponsUltraCapacitorsLevel2", c_techCountCompleteOnly) == 1))) {
        lv_upgrades_string = lv_upgrades_string + "Infantry Weapons Level 2, ";
    }
    else if (((TechTreeUpgradeCount(1, "TerranInfantryWeaponsLevel1", c_techCountCompleteOnly) == 1) || (TechTreeUpgradeCount(1, "TerranInfantryWeaponsUltraCapacitorsLevel1", c_techCountCompleteOnly) == 1))) {
        lv_upgrades_string = lv_upgrades_string + "Infantry Weapons Level 1, ";
    }
    if (((TechTreeUpgradeCount(1, "TerranVehicleWeaponsLevel3", c_techCountCompleteOnly) == 1) || (TechTreeUpgradeCount(1, "TerranVehicleWeaponsUltraCapacitorsLevel3", c_techCountCompleteOnly) == 1))) {
        lv_upgrades_string = lv_upgrades_string + "Vehicle Weapons Level 3, ";
    }
    else if (((TechTreeUpgradeCount(1, "TerranVehicleWeaponsLevel2", c_techCountCompleteOnly) == 1) || (TechTreeUpgradeCount(1, "TerranVehicleWeaponsUltraCapacitorsLevel2", c_techCountCompleteOnly) == 1))) {
        lv_upgrades_string = lv_upgrades_string + "Vehicle Weapons Level 2, ";
    }
    else if (((TechTreeUpgradeCount(1, "TerranVehicleWeaponsLevel1", c_techCountCompleteOnly) == 1) || (TechTreeUpgradeCount(1, "TerranVehicleWeaponsUltraCapacitorsLevel1", c_techCountCompleteOnly) == 1))) {
        lv_upgrades_string = lv_upgrades_string + "Vehicle Weapons Level 1, ";
    }
    if (((TechTreeUpgradeCount(1, "TerranShipWeaponsLevel3", c_techCountCompleteOnly) == 1) || (TechTreeUpgradeCount(1, "TerranShipWeaponsUltraCapacitorsLevel3", c_techCountCompleteOnly) == 1))) {
        lv_upgrades_string = lv_upgrades_string + "Ship Weapons Level 3, ";
    }
    else if (((TechTreeUpgradeCount(1, "TerranShipWeaponsLevel2", c_techCountCompleteOnly) == 1) || (TechTreeUpgradeCount(1, "TerranShipWeaponsUltraCapacitorsLevel2", c_techCountCompleteOnly) == 1))) {
        lv_upgrades_string = lv_upgrades_string + "Ship Weapons Level 2, ";
    }
    else if (((TechTreeUpgradeCount(1, "TerranShipWeaponsLevel1", c_techCountCompleteOnly) == 1) || (TechTreeUpgradeCount(1, "TerranShipWeaponsUltraCapacitorsLevel1", c_techCountCompleteOnly) == 1))) {
        lv_upgrades_string = lv_upgrades_string + "Ship Weapons Level 1, ";
    }
    if ((lv_upgrades_string == "")) {
        libEFA54406_gf_create_context("upgrades", "You don't have any upgrades", true);
    }
    else {
        libEFA54406_gf_create_context("upgrades", "Current upgrades: " + lv_upgrades_string, true);
    }
    return true;
}

