//--------------------------------------------------------------------------------------------------
// Trigger: Startup Context
//--------------------------------------------------------------------------------------------------
bool libEFA54406_gt_StartupContext_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(0.4, c_timeReal);
    TriggerSendEvent("startup_context");
    if ((libEFA54406_gv_is_intermission == false)) {
        libEFA54406_gf_create_context("mission_intro", "You have entered a mission. You can assist the player and have access to powerful abilities which use a regenerating Energy resource.", true);
        libEFA54406_gf_ObjectiveContext(false, "");
        if ((libEFA54406_gv_is_blocking == false)) {
            libEFA54406_gf_PlayerUnitsContext("all");
            TriggerExecute(libEFA54406_gt_Currentupgrades, true, false);
            if ((libEFA54406_gv_is_nobuild == false)) {
                TriggerExecute(libEFA54406_gt_Currentresources, true, false);
                TriggerExecute(libEFA54406_gt_Currentsupply, true, false);
            }

        }

    }

    return true;
}

