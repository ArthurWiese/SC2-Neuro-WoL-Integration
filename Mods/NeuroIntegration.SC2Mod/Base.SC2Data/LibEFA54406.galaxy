    if (testConds) {
        if (!((((EventPlayer() == 1) && (UnitGetOwner(EventUnitTarget()) != 1)) || ((UnitGetOwner(EventUnitTarget()) == 1) && (libNtve_gf_PlayerIsEnemy(1, EventPlayer(), libNtve_ge_PlayerRelation_Enemy) == true))))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libEFA54406_gv_entered_combat = true;
    return true;
}

