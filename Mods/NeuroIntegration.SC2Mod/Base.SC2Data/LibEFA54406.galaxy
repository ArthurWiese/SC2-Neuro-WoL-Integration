    // Actions
    if (!runActions) {
        return true;
    }

    libEFA54406_gv_bankwriteallowed = false;
    BankLoad("NeuroIntegration", 1);
    BankWait(BankLastCreated());
    libEFA54406_gv_currentbankbackupid = BankValueGetAsInt(BankLastCreated(), "game_state", "backup_bank_id");
    if ((BankValueGetAsFlag(BankLastCreated(), "game_state", "startup_context") == true)) {
        BankValueSetFromFlag(BankLastCreated(), "game_state", "startup_context", false);
        TriggerExecute(libEFA54406_gt_StartupContext, true, false);
    }

    if ((libEFA54406_gv_displayNameString != BankValueGetAsString(BankLastCreated(), "game_state", "display_name"))) {
        libEFA54406_gv_displayNameString = BankValueGetAsString(BankLastCreated(), "game_state", "display_name");
        auto89E4B579_val = libEFA54406_gv_displayNameString;
        if (auto89E4B579_val == "Neuro-sama") {
            libEFA54406_gv_displayNameText = StringExternal("Param/Value/lib_EFA54406_05755519");
        }
        else if (auto89E4B579_val == "Evil Neuro") {
            libEFA54406_gv_displayNameText = StringExternal("Param/Value/lib_EFA54406_1B920E42");
        }
        else {
